def rendement_théorique(Tf,Z):
    n=10**3
    Zpn = z
    Tc=np.linspace(Tf,200+Tf,n)
    r=np.zeros((n,1))
    for i in range(n):
        Tm=(Tc[i]+Tf)/2
        r[i]=(Tc[i]-Tf)*(sqrt(1+Zpn*Tm)-1)/(Tc[i]*(sqrt(1+Zpn*Tm)+(Tf/Tc[i])))
    return Tc,r

